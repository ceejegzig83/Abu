# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Optional for Production PostgreSQL Backend)
# When provided, replaces the in-browser persistence with live PostgreSQL & RLS.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# SOCIAL FEED PROVIDER SETTINGS (Configurable via Admin Portal)
VITE_SOCIAL_FEED_PROVIDER="facebook"
VITE_FACEBOOK_PAGE_URL="https://www.facebook.com/ABU-JIBRIL-II"
